# ==============================================================================
# CampusSignal AI — Environment Variables
# ==============================================================================

# Google AI Studio / Gemini API Configuration
# Get your key at https://aistudio.google.com
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# Verified Models (Check availability in your Google AI Studio account):
# Recommended Gemini Model: gemini-2.5-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Recommended Gemma Model: gemma-2-9b-it, gemma-2-27b-it, or gemma-4-31b-it
GEMMA_MODEL=gemma-2-9b-it

# Supabase PostgreSQL Configuration
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Next.js Public Host URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
