# Copy this template to .env.local and supply your own credentials.
# Never place secrets in NEXT_PUBLIC_ variables. Supabase sessions use the public anon key; database access is restricted by RLS.
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMMA_MODEL=gemini-3.5-flash

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000


